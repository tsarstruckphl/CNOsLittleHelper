{
  "manifest_version": 3,
  "name": "CNO's Little Helper",
  "short_name": "CNO Helper",
  "version": "1.1.9",
  "description": "For fantasy sports use of Crazy Ninja Odds. Enhances CNO with modern UI, odds-to-percent conversion, injury status, MLB weather, AP ranks, market search, & more!",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "contextMenus"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png"
      ],
      "matches": [
        "*://crazyninjaodds.com/*",
        "*://*.crazyninjaodds.com/*",
        "*://*.crazyninjamike.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CNO's Little Helper"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://crazyninjaodds.com/*",
        "*://*.crazyninjaodds.com/*",
        "*://*.crazyninjamike.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "config.js",
        "features-data.js",
        "features-ui.js",
        "filter-ui.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "*://crazyninjaodds.com/*",
    "*://*.crazyninjaodds.com/*",
    "*://*.crazyninjamike.com/*",
    "https://docs.google.com/spreadsheets/d/e/2PACX-1vQcB7_SaAEsLEKjjI9Gol2JPAZyVlpasz13wmc7L6MaK8cIfUiRVutHvic_KE_MjTbc8unFJ27W0zZV/*",
    "https://docs.google.com/spreadsheets/d/e/2PACX-1vTS09M-p05Qs9ZTzM2VtV5S7g9i9HA3Fw7XqwH_Sv7h8xYwyoixibXoCxPx46Ojxex0l76o5oAEJuWe/*",
    "https://site.api.espn.com/apis/site/v2/sports/*",
    "https://api.github.com/*"
  ]
}